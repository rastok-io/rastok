type Reply = map<text, variant>

graph relay : App {
  connector shell : Process {
    mode = job ; command = "cat"
    codec = jsonl
    effect = idempotent ; behavior = deterministic
    timeout = duration("5s")
  }

  operator sift {
    on in where data is Reply && data["status"] == "ok" { out = data["value"] }
  }

  . -> shell
  shell.out -> sift
  shell.err -> nothing
  shell.exit -> nothing
  sift -> .
}

lab relay {
  simulation golden on app {
    mock shell {
      on in {
        out = {"status": "ok", "value": 7}
        exit = Exited { exit_code = 0, signal = null }
      }
    }

    scenario roundtrip "a struct request opens one canonical line; the mock answers the wire's shape" {
      app.in = { price = decimal("19.99"), n = 42 }
      expect "sifted" app.out count == 1 where data == 7
    }
  }
}
