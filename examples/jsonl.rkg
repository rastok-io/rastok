type Reply = map<text, variant>

graph relay : App {
  connector shell : Process {
    mode = job ; command = "cat"
    codec = jsonl
    idempotent = true; behavior = deterministic
    timeout = duration("5s")
  }

  operator sift {
    on in where data is Reply && data["status"] == "ok" { out = data["value"] }
  }

  in -> shell
  shell.out -> sift
  shell.err -> nothing
  shell.exit -> nothing
  sift -> out
}

lab golden {
  mock shell {
    on in {
      out = {"status": "ok", "value": 7}
      exit = Exited { exit_code = 0, signal = null }
    }
  }

  scenario roundtrip {
    app.in = { price = decimal("19.99"), n = 42 }
    expect app.out == 7
  }
}
