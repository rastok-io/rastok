// The Lab supplies decoded HTTP requests; no socket or paid service is used.
// All addresses, emails, credentials and charges in the fixture are fictional.
type Webhook = struct {
  event_id: text
  email: text @personal(identifier = true)
  amount: int
}
type Attempt = struct { event: Webhook, attempt: int }
type Delivered = struct { event_id: text, attempts: int, status: int }
type Failure = union {
  Rejected { reason: text }
  PartnerFailed { event_id: text, reason: text }
  LoopExpired { last_state: Attempt }
}
type PartnerExit = union {
  Completed { status: int }
  DnsFailed {}
  ConnectFailed {}
  TlsFailed {}
  ProtocolFailed {}
  TimeoutExpired {}
  BodyTooLarge { limit: uint }
  DecodeFailed {}
  OutcomeUnknown {}
}
type Receipt = struct {
  charge: decimal(38,18) @cost(currency = USD, basis = provider_reported)
}
type Charge = decimal(38,18)
type WireReceipt = struct { charge: variant }

graph webhook_to_partner : App {
  output done: Delivered
  output failed: Failure
  output duplicate: text

  connector listener : HttpServer {
    listen = "127.0.0.1:8080"
    path = "/events"
    codec = json
    max_body = "16 KiB"
  }

  operator validate {
    input in: variant
    output out: Webhook
    output failed: Failure
    on in match {
      data is Webhook => match {
        data.amount > 0 && size(data.event_id) > 0 => out = data as Webhook
        _ => failed = Rejected { reason = "positive amount and event id required" }
      }
      _ => failed = Rejected { reason = "expected event_id, email and integer amount" }
    }
  }

  operator deduplicate {
    input in: Webhook
    output out: Attempt
    output duplicate: text
    instance = { key = data.event_id }
    lifetime = { kind = idle; after = duration("5m") }
    var seen: bool = false
    on in match {
      seen => duplicate = data.event_id
      _ => {
        seen = true
        out = { event = data; attempt = 0 }
      }
    }
  }

  graph deliver : Loop {
    input in: Attempt
    output done: Delivered
    output failed: Failure
    instance = { key = data.event.event_id }
    Loop.fuel = 2
    Loop.terminal = [done, failed]
    Loop.expired = failed
    Loop.delay = { kind = fixed; after = duration("1s") }

    operator request {
      input in: Attempt
      output out: variant
      on in {
        // JSON erases the field schema: retain personal-data policy on the
        // opaque body, while the non-personal event id remains a typed key.
        out = {
          data = data as variant
          meta.app.event_id = data.event.event_id
        }
      }
    }

    connector partner : HttpClient {
      url = env("PARTNER_URL")
      auth_bearer = secret("showcase/partner/token")
      method = "POST"
      codec = json
      timeout = duration("1s")
      max_body = "16 KiB"
      idempotency_key = meta.app.event_id
      // Required partner contract: honour this key; attempt is audit-only.
      // This declaration does not prove that a real service honours that contract.
      effect = idempotent
      behavior = deterministic
    }

    operator accounting {
      input in: variant
      output out: Receipt
      on in match {
        data is WireReceipt => match {
          data.charge is Charge => out = { charge = data.charge as Charge }
          _ => nothing
        }
        _ => nothing
      }
    }

    operator decide {
      input in: PartnerExit
      output retry: Attempt
      output done: Delivered
      output failed: Failure
      on in match {
        data is Completed && data.status >= 200 && data.status < 300 => done = {
          event_id = Loop.state.data.event.event_id
          attempts = Loop.state.data.attempt + 1
          status = data.status
        }
        data is Completed && data.status >= 500 => retry = {
          event = Loop.state.data.event
          attempt = Loop.state.data.attempt + 1
        }
        data is TimeoutExpired || data is DnsFailed || data is ConnectFailed => retry = {
          event = Loop.state.data.event
          attempt = Loop.state.data.attempt + 1
        }
        _ => failed = PartnerFailed {
          event_id = Loop.state.data.event.event_id
          reason = "terminal transport failure"
        }
      }
    }

    in -> request -> partner
    partner.out -> accounting -> nothing
    partner.exit -> decide
    decide.retry -> Loop.next
    decide.done -> done
    decide.failed -> failed
  }

  listener.out -> validate -> deduplicate -> deliver
  listener.exit -> nothing
  validate.failed -> failed
  deduplicate.duplicate -> duplicate
  deliver.done -> done
  deliver.failed -> failed
}

lab webhook_to_partner {
  simulation webhook on app {
    mock deliver.partner {
      on in where data is Attempt && data.event.event_id == "dead" {
        out = nothing
      }
      on in where data is Attempt && data.event.event_id == "retry" && data.attempt == 0 {
        out = nothing
      }
      on in where data is Attempt && data.event.event_id == "http-500" && data.attempt == 0 {
        out = { charge = decimal("0.01") }
        exit = Completed { status = 500 }
      }
      on in {
        out = { charge = decimal("0.02") }
        exit = Completed { status = 201 }
      }
    }

    scenario nominal "ACK, validate, deliver once" {
      listener.out = { event_id = "ok"; email = "alice@example.test"; amount = 12 }
      expect listener.exit count == 1 where data is Completed && data.status == 202
      expect app.done count == 1 where data.event_id == "ok" && data.attempts == 1 && data.status == 201
      expect deliver.partner.in count == 1
      expect deliver.accounting.out count == 1
      expect nothing app.failed
    }

    scenario timeout_then_success "only the failed application is repeated" {
      listener.out = { event_id = "retry"; email = "alice@example.test"; amount = 12 }
      expect listener.exit count == 1 where data is Completed && data.status == 202
      expect nothing app.done
      advance duration("1s")
      expect deliver.partner.exit count == 1 where data is TimeoutExpired
      expect nothing deliver.partner.in
      advance duration("1s")
      expect deliver.partner.in count == 1
      expect app.done count == 1 where data.attempts == 2
      expect nothing app.failed
    }

    scenario partner_dead "two attempts, then explicit exhaustion" {
      listener.out = { event_id = "dead"; email = "alice@example.test"; amount = 12 }
      advance duration("1s")
      advance duration("1s")
      advance duration("1s")
      expect app.failed count == 1 where data is LoopExpired && data.last_state.attempt == 2
      expect nothing app.done
      advance duration("10s")
      expect nothing deliver.partner.in
      expect nothing app.failed
    }

    scenario duplicate "explicit state suppresses a duplicate, not instance identity alone" {
      listener.out = { event_id = "same"; email = "alice@example.test"; amount = 12 }
      expect app.done count == 1
      listener.out = { event_id = "same"; email = "alice@example.test"; amount = 12 }
      expect listener.exit count == 1 where data is Completed && data.status == 202
      expect app.duplicate count == 1 where data == "same"
      expect nothing deliver.partner.in
      expect nothing app.done
      advance duration("5m")
      listener.out = { event_id = "same"; email = "alice@example.test"; amount = 12 }
      expect app.done count == 1
      expect nothing app.duplicate
    }

    scenario invalid_payload "decoded but ill-typed or invalid business data is rejected after ACK" {
      listener.out = json! { "unexpected": true }
      expect listener.exit count == 1 where data is Completed && data.status == 202
      expect app.failed count == 1 where data is Rejected
      expect nothing deliver.partner.in
      listener.out = { event_id = "invalid"; email = "alice@example.test"; amount = -1 }
      expect listener.exit count == 1 where data is Completed && data.status == 202
      expect app.failed count == 1 where data is Rejected
      expect nothing deliver.partner.in
    }

    scenario http_500 "500 is a response; the graph explicitly chooses to retry" {
      listener.out = { event_id = "http-500"; email = "alice@example.test"; amount = 12 }
      expect deliver.partner.exit count == 1 where data is Completed && data.status == 500
      expect nothing app.done
      advance duration("1s")
      expect app.done count == 1 where data.attempts == 2 && data.status == 201
      expect nothing app.failed
    }
  }
}
