// Bob completes once; only Alice times out, waits and retries the same request.
// Instances isolate tenants. Retry owns attempt ordinals; DATA does not.

type Request = struct {
  tenant: text
  prompt: text
}

type Answer = struct {
  tenant: text
  prompt: text
}

type ModelExit = union {
  CaptureFailed {}
  DecodeFailed { line: text?, message: text }
  Exited { exit_code: int, signal: int? }
  OutcomeUnknown {}
  OutputOverflow { limit: uint, reason: enum { budget, capacity } }
  SpawnFailed { message: text }
  TimeoutExpired {}
}

graph agent_retry : App {
  input in: Request
  output done: Answer
  output failed: ModelExit

  instance = { key = data.tenant }
  lifetime = { kind = idle; after = duration("10s") }
  closing = { drain_for = duration("1s"); settle_for = duration("1s") }

  graph audit {
    input in: Request

    operator observe {
      input in: Request
      output out: text

      on in { out = data.tenant }
    }

    in -> observe
    observe.out -> nothing
  }

  connector model : Process + Retry {
    mode = job
    command = "cat"
    codec = jsonl
    idempotent = true
    behavior = probabilistic
    timeout = duration("1s")
    max_output = "1 MiB"
    Retry.attempts = 2
    Retry.on = [TimeoutExpired]
    Retry.delay = { kind = fixed; after = duration("1s") }
  }

  operator answer {
    input in: variant
    output out: Answer
    on in match {
      data is Answer => out = data as Answer
      _ => nothing
    }
  }

  in -> { audit; model }
  model.out -> answer -> done
  model.err -> nothing
  model.exit -> match {
    Exited -> nothing
    _ -> failed
  }
}

lab ui_tour {
  mock model {
    on in where data is Request && data.tenant == "alice" && now() == timestamp("1970-01-01T00:00:00Z") {
      out = nothing
    }
    on in {
      out = data
      exit = Exited { exit_code = 0; signal = null }
    }
  }

  scenario two_tenants {
    app.in = { tenant = "alice"; prompt = "Explain causal replay" }
    expect app.done == nothing

    app.in = { tenant = "bob"; prompt = "Explain typed envelopes" }
    expect app.done where data.tenant == "bob"

    advance duration("1s")
    expect app.done == nothing
    expect model.in == nothing

    advance duration("1s")
    expect app.done where data.tenant == "alice"
    expect answer.in where data is Answer && data.tenant == "alice"
    expect 0 model.in where data is Request && data.tenant == "bob"
    expect audit.observe.in == nothing
    expect 0 app.done where data.tenant == "bob"
    expect app.failed == nothing
  }

  scenario lifetime {
    app.in = { tenant = "bob"; prompt = "First generation" }
    expect app.done where data.prompt == "First generation"
    advance duration("10s")
    expect model.in == nothing
    app.in = { tenant = "bob"; prompt = "Next generation" }
    expect app.done where data.prompt == "Next generation"
    expect app.failed == nothing
  }
}
