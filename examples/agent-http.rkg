// One non-streaming OpenAI Responses request per job. The Lab never calls a model.
// No Retry: an inference can be charged again; no idempotence is invented here.
val model_name = "gpt-6-astra"
val simulated_message = json! {"type":"message","role":"assistant","content":[{"type":"output_text","text":"Hello from the simulated model.","annotations":[]}]}

type Job = struct { session: text, job: text, prompt: text }
type JsonObject = map<text, variant>
type ResponseUsage = struct {
  input_tokens: uint @measure(id = input_tokens, unit = "token")
  output_tokens: uint @measure(id = output_tokens, unit = "token")
  total_tokens: uint @measure(id = total_tokens, unit = "token")
  input_tokens_details: JsonObject?
  output_tokens_details: JsonObject?
}
type ModelResponse = struct {
  id: text
  object: text
  output: array<variant>
  status: text?
  usage: ResponseUsage?
  error: JsonObject?
}
type UnknownUsage = struct { session: text, job: text, reason: text }

graph agent_http : App {
  input in: Job
  output response: ModelResponse
  output unknown: UnknownUsage
  output failed: HttpClientExit
  instance = { key = data.session }

  operator request {
    input in: Job
    output out: variant
    on in {
      val body = { model = model_name; input = data.prompt; stream = false; store = false; max_output_tokens = 128 }
      out = {
        data = body as variant
        meta.app.session = data.session
        meta.app.job = data.job
      }
    }
  }
  connector model : HttpClient {
    url = env("MODEL_URL")
    auth_bearer = secret("showcase/model/token")
    method = "POST"
    codec = json
    json_profile = projected
    output out: ModelResponse
    timeout = duration("10s")
    max_body = "256 KiB"
    behavior = probabilistic
  }
  // Quantities already live on model.out. This Operator only explains absence;
  // it neither extracts, copies nor totals measurements.
  operator explain_usage {
    input in: ModelResponse
    output unknown: UnknownUsage
    on in match {
      data.usage is ResponseUsage => nothing
      _ => unknown = { session = meta.app.session as text; job = meta.app.job as text; reason = "usage not reported" }
    }
  }
  operator terminal {
    input in: HttpClientExit
    output failed: HttpClientExit
    output unknown: UnknownUsage
    on in match {
      data is Completed => match {
        data.status >= 200 && data.status < 300 => nothing
        _ => failed = Completed { status = data.status }
      }
      data is ServerError => failed = ServerError { status = data.status }
      _ => {
        failed = .
        unknown = { session = meta.app.session as text; job = meta.app.job as text; reason = "no usable response" }
      }
    }
  }

  in -> request -> model
  model.out -> { response; explain_usage }
  explain_usage.unknown -> unknown
  model.exit -> terminal
  terminal.failed -> failed
  terminal.unknown -> unknown
}

lab responses {
  // Mocks supply already typed values. Wire-shape refusals are separately
  // tested against the real HTTP decoder, not inferred from this Lab.
  mock model {
    on in match {
      meta.app.job == "missing" || meta.app.job == "null" => {
        out = { id = "resp_without_usage"; object = "response"; output = []; status = "completed"; usage = null; error = null }
        exit = Completed { status = 200 }
      }
      meta.app.job == "invalid" || meta.app.job == "error_body" => exit = DecodeFailed {}
      meta.app.job == "zero" => {
        out = { id = "resp_zero"; object = "response"; output = []; status = "completed"; usage = { input_tokens = 0u; output_tokens = 0u; total_tokens = 0u; input_tokens_details = null; output_tokens_details = null }; error = null }
        exit = Completed { status = 200 }
      }
      meta.app.job == "timeout" => nothing
      meta.app.job == "server_error" => {
        out = { id = "resp_failed"; object = "response"; output = []; status = "failed"; usage = null; error = {"message": "scripted service error"} }
        exit = ServerError { status = 500 }
      }
      _ => {
        out = {
          id = "resp_fixture"
          object = "response"
          output = [simulated_message]
          status = "completed"
          usage = { input_tokens = 12u; output_tokens = 4u; total_tokens = 16u; input_tokens_details = {"cached_tokens": 0}; output_tokens_details = {"reasoning_tokens": 0} }
          error = null
        }
        exit = Completed { status = 200 }
      }
    }
  }
  scenario two_sessions {
    app.in = { session = "alice"; job = "a1"; prompt = "Hello" }
    expect model.out where meta.app.session == "alice" && meta.app.job == "a1"
    app.in = { session = "bob"; job = "b1"; prompt = "Hello" }
    expect model.out where meta.app.session == "bob" && meta.app.job == "b1"
    app.in = { session = "alice"; job = "a2"; prompt = "Another independent job" }
    expect model.out where meta.app.session == "alice" && meta.app.job == "a2"
    expect app.unknown == nothing
    expect app.failed == nothing
  }
  scenario missing_usage {
    app.in = { session = "alice"; job = "missing"; prompt = "Hello" }
    expect app.unknown where data.reason == "usage not reported"
    app.in = { session = "alice"; job = "null"; prompt = "Hello" }
    expect app.unknown where data.reason == "usage not reported"
    expect app.failed == nothing
  }
  scenario observed_zero {
    app.in = { session = "alice"; job = "zero"; prompt = "Hello" }
    expect model.out where data.usage is ResponseUsage && data.usage.input_tokens == 0u && data.usage.output_tokens == 0u && data.usage.total_tokens == 0u
    expect app.unknown == nothing
  }
  scenario schema_failure {
    app.in = { session = "bob"; job = "invalid"; prompt = "Hello" }
    expect app.failed where data is DecodeFailed
    expect app.unknown
    expect model.out == nothing
  }
  scenario transport_failure {
    app.in = { session = "alice"; job = "timeout"; prompt = "Hello" }
    advance duration("10s")
    expect app.failed == TimeoutExpired {}
    expect app.unknown
    expect model.out == nothing
  }
  scenario http_errors {
    app.in = { session = "alice"; job = "server_error"; prompt = "Hello" }
    expect app.failed where data is ServerError && data.status == 500
    expect model.out
    app.in = { session = "alice"; job = "error_body"; prompt = "Hello" }
    expect app.failed where data is DecodeFailed
    expect model.out == nothing
  }
}
