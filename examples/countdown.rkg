// A passive App wires one finite Operator application. The measure proves
// termination; Loop.next is a manager command, not a spatial back-edge.
graph countdown : App {
  input in: int
  output out: text

  operator count : Loop {
    input in: int
    output out: text
    Loop.measure = Loop.state.data

    on in match {
      data > 0 => Loop.next = data - 1
      _        => out = "liftoff"
    }
  }

  in -> count -> out
}

lab proof {
  scenario positive {
    app.in = 3
    expect app.out == "liftoff"
  }
  scenario already_finished {
    app.in = 0
    expect app.out == "liftoff"
  }
}
