graph gauge : App {
  input feed : text
  output measure : int

  operator meter {
    input evt : text
    output score : int

    on evt {
      score = size(data)
    }
  }

  feed -> meter.evt
  meter.score -> measure
}

lab golden {
  scenario roundtrip {
    app.feed = "salut"
    expect app.measure == 5
  }
}
