// Bounded File read, byte count and empty-file validation, atomic replacement.
// The deployment root is supplied by --file-root; the Lab never opens a file.

graph file_pipeline : App {
  input in: text
  output bytes_read: int
  output empty: bool
  output failed: FileExit // Standard-library type; no import is needed.

  connector read_file : File {
    mode = read
    path = data as text
    max_read = "64KiB"
    timeout = duration("2s")
  }
  operator inspect {
    input in: bytes
    output accepted: bytes
    output bytes_read: int
    output empty: bool
    on in match {
      size(data) > 0 => { bytes_read = size(data); accepted = data }
      _ => empty = true
    }
  }
  connector write_file : File {
    mode = replace
    path = "copy.txt"
    timeout = duration("2s")
  }

  in -> read_file -> inspect
  inspect.accepted -> write_file
  inspect.bytes_read -> bytes_read
  inspect.empty -> empty
  write_file.out -> nothing
  read_file.exit -> match { Completed -> nothing; _ -> failed }
  write_file.exit -> match { Completed -> nothing; _ -> failed }
}

lab files {
  mock read_file {
    on in { out = base64! { YWxwaGEKYmV0YQo= }; exit = Completed {} }
  }
  mock write_file {
    on in { exit = Completed {} }
  }
  scenario copy {
    app.in = "input.txt"
    expect app.bytes_read == 11
    expect write_file.in where size(data) == 11
    expect app.failed == nothing
  }
  scenario empty {
    mock read_file { on in { out = base64! {}; exit = Completed {} } }
    app.in = "empty.txt"
    expect app.empty
    expect write_file.in == nothing
  }
  scenario utf8 {
    mock read_file { on in { out = base64! { w6kK }; exit = Completed {} } }
    app.in = "utf8.txt"
    expect app.bytes_read == 3
    expect write_file.in where size(data) == 3
    expect app.failed == nothing
  }
  scenario directory {
    mock read_file { on in { exit = NotAFile {} } }
    app.in = "directory"
    expect app.failed where data is NotAFile
    expect write_file.in == nothing
  }
  scenario single_byte {
    mock read_file { on in { out = base64! { eA== }; exit = Completed {} } }
    app.in = "single-byte.txt"
    expect app.bytes_read == 1
    expect write_file.in where size(data) == 1
    expect app.empty == nothing
    expect app.failed == nothing
  }
}
