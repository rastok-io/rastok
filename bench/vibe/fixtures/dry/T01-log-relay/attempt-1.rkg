```rkg
graph relay : App {
  input in: text
  output out: text

  connector logger : Process {
    mode = job ; command = "cat"
    codec = lines
    effect = idempotent ; behavior = deterministic
  }

  operator screen {
    input in: text
    output out: text
    on in where data != "" {
      out = data
    }
  }

  in -> screen -> logger -> out
  logger.err -> nothing
  logger.exit -> nothing
}
```
