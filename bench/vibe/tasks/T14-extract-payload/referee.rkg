lab extract {
  simulation refereeing {
    mock forwarder {
      on in { out = .; exit = Exited { exit_code = 0; signal = null } }
    }

    scenario unwraps {
      app.in = {site = "alpha-7", payload = "flow 12"}
      expect forwarder.in where data == "flow 12"
      expect app.out where data == "flow 12"
    }
  }
}
