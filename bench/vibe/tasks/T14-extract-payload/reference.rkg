graph extract : App {
  input in: struct { site: text, payload: text }
  output out: text

  connector forwarder : Process {
    mode = job ; command = "cat"
    codec = lines
    idempotent = true ; behavior = deterministic
  }

  operator unwrap {
    input in: struct { site: text, payload: text }
    output out: text
    on in {
      out = data.payload
    }
  }

  in -> unwrap -> forwarder -> out
  forwarder.err -> nothing
  forwarder.exit -> nothing
}
