graph triage : App {
  input in: struct { level: text, message: text }
  output out: text

  connector notifier : Process {
    mode = job ; command = "cat"
    codec = lines
    idempotent = true ; behavior = deterministic
  }

  operator gate {
    input in: struct { level: text, message: text }
    output out: text
    on in where data.level == "critical" {
      out = data.message
    }
  }

  in -> gate -> notifier -> out
  notifier.err -> nothing
  notifier.exit -> nothing
}
