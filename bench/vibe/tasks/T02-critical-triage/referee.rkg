lab triage {
  simulation refereeing {
    mock notifier {
      on in { out = .; exit = Exited { exit_code = 0; signal = null } }
    }

    scenario critical_passes {
      app.in = {level = "critical", message = "pump 3 overheating"}
      expect app.out where data == "pump 3 overheating"
      expect notifier.err == nothing
    }

    scenario info_dropped {
      app.in = {level = "info", message = "routine check"}
      expect notifier.in == nothing
      expect app.out == nothing
    }
  }
}
