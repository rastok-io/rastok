lab window {
  simulation refereeing {
    scenario closes {
      app.in = "a"
      expect app.out where data == "a"
      app.in = "b"
      expect app.out where data == "b"
      app.in = "c"
      expect app.out where data == "c"
      app.in = "d"
      expect app.out == nothing
      app.in = "e"
      expect app.out == nothing
    }
  }
}
