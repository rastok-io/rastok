lab tariffs {
  simulation refereeing {
    scenario low {
      app.in = {price = 49}
      expect app.out where data.band == "low"
    }

    scenario mid {
      app.in = {price = 50}
      expect app.out where data.band == "mid"
      app.in = {price = 150}
      expect app.out where data.band == "mid"
    }

    scenario high {
      app.in = {price = 151}
      expect app.out where data.band == "high"
    }
  }
}
