graph hysteresis : App {
  input in: struct { value: int }
  output out: struct { state: text }

  operator latch {
    input in: struct { value: int }
    output out: struct { state: text }
    var state : text = "normal"
    on in {
      state = data.value > 120 ? "tripped" : (data.value < 80 ? "normal" : state)
      out = {state = state}
    }
  }

  in -> latch -> out
}
