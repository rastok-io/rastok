lab hysteresis {
  simulation refereeing on app {
    scenario latching "the alarm trips high and releases low" {
      app.in = {value = 100}
      expect "starts normal" app.out count == 1 where data.state == "normal"
      app.in = {value = 121}
      expect "trips" app.out count == 1 where data.state == "tripped"
      app.in = {value = 100}
      expect "holds" app.out count == 1 where data.state == "tripped"
      app.in = {value = 79}
      expect "releases" app.out count == 1 where data.state == "normal"
    }
  }
}
