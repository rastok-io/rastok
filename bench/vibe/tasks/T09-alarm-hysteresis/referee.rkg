lab hysteresis {
  simulation refereeing {
    scenario latching {
      app.in = {value = 100}
      expect app.out where data.state == "normal"
      app.in = {value = 121}
      expect app.out where data.state == "tripped"
      app.in = {value = 100}
      expect app.out where data.state == "tripped"
      app.in = {value = 79}
      expect app.out where data.state == "normal"
    }
  }
}
