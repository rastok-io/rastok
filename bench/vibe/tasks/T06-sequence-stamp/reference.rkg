graph stamp : App {
  input in: text
  output out: struct { seq: int, text: text }

  operator number {
    input in: text
    output out: struct { seq: int, text: text }
    var seen : int = 0
    on in {
      seen = seen + 1
      out = {seq = seen, text = data}
    }
  }

  in -> number -> out
}
