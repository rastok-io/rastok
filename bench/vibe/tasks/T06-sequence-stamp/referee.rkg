lab stamp {
  simulation refereeing {
    scenario ordered {
      app.in = "first"
      expect app.out where data.seq == 1 && data.text == "first"
      app.in = "second"
      expect app.out where data.seq == 2 && data.text == "second"
      app.in = "third"
      expect app.out where data.seq == 3 && data.text == "third"
    }
  }
}
