graph export : App {
  input in: text
  output out: text
  output err: union { TimeoutExpired {} }

  connector exporter : Process {
    mode = job ; command = "cat"
    codec = lines
    idempotent = true ; behavior = deterministic
    timeout = duration("2s")
  }

  operator relay {
    input in: text
    output out: text
    on in {
      out = data
    }
  }

  in -> relay -> exporter -> out
  exporter.err -> nothing
  exporter.exit -> match {
    TimeoutExpired -> err
    _ -> nothing
  }
}
