lab export {
  simulation refereeing {
    scenario answers {
      mock exporter {
        on in { out = .; exit = Exited { exit_code = 0; signal = null } }
      }
      app.in = "reading 42"
      expect app.out where data == "reading 42"
      expect app.err == nothing
    }

    scenario hangs {
      mock exporter {
        on in { out = nothing }
      }
      app.in = "reading 43"
      advance duration("2s")
      expect app.err where data is TimeoutExpired
      expect app.out == nothing
    }
  }
}
