lab bounds {
  simulation refereeing {
    scenario inside {
      app.in = {value = 50, low = 0, high = 100}
      expect app.out where data.ok == true
    }

    scenario on_edge {
      app.in = {value = 100, low = 0, high = 100}
      expect app.out where data.ok == true
    }

    scenario outside {
      app.in = {value = 101, low = 0, high = 100}
      expect app.out where data.ok == false
    }
  }
}
