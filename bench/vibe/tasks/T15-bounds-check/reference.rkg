graph bounds : App {
  input in: struct { value: int, low: int, high: int }
  output out: struct { ok: bool }

  operator inside {
    input in: struct { value: int, low: int, high: int }
    output out: struct { ok: bool }
    on in {
      out = {ok = data.low <= data.value && data.value <= data.high}
    }
  }

  in -> inside -> out
}
