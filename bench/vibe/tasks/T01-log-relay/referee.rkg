lab relay {
  simulation refereeing {
    mock logger {
      on in { out = .; exit = Exited { exit_code = 0; signal = null } }
    }

    scenario forwards {
      app.in = "pump 3 nominal"
      expect app.out where data == "pump 3 nominal"
      expect logger.err == nothing
    }

    scenario drops_empty {
      app.in = ""
      expect logger.in == nothing
      expect app.out == nothing
    }
  }
}
