graph streaks : App {
  input in: struct { ok: bool }
  output out: struct { streak: int }

  operator count_failures {
    input in: struct { ok: bool }
    output out: struct { streak: int }
    var streak : int = 0
    on in {
      streak = data.ok ? 0 : streak + 1
      out = {streak = streak}
    }
  }

  in -> count_failures -> out
}
