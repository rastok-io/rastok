lab streaks {
  simulation refereeing {
    scenario counting {
      app.in = {ok = false}
      expect app.out where data.streak == 1
      app.in = {ok = false}
      expect app.out where data.streak == 2
      app.in = {ok = true}
      expect app.out where data.streak == 0
      app.in = {ok = false}
      expect app.out where data.streak == 1
    }
  }
}
