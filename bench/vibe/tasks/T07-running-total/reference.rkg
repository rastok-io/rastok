graph totals : App {
  input in: struct { amount: int }
  output out: struct { total: int }

  operator accumulate {
    input in: struct { amount: int }
    output out: struct { total: int }
    var sum : int = 0
    on in {
      sum = sum + data.amount
      out = {total = sum}
    }
  }

  in -> accumulate -> out
}
