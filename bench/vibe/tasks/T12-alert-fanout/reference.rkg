graph fanout : App {
  input in: struct { level: text, message: text }
  output out: text

  connector archive : Process {
    mode = job ; command = "cat"
    codec = lines
    idempotent = true ; behavior = deterministic
  }

  connector pager : Process {
    mode = job ; command = "cat"
    codec = lines
    idempotent = true ; behavior = deterministic
  }

  operator gate {
    input in: struct { level: text, message: text }
    output out: text
    on in where data.level == "critical" {
      out = data.message
    }
  }

  in -> gate
  gate.out -> archive.in
  gate.out -> pager.in
  archive.out -> out
  pager.out -> out
  archive.err -> nothing
  archive.exit -> nothing
  pager.err -> nothing
  pager.exit -> nothing
}
