lab fanout {
  simulation refereeing {
    mock archive { on in { out = .; exit = Exited { exit_code = 0; signal = null } } }
    mock pager { on in { out = .; exit = Exited { exit_code = 0; signal = null } } }

    scenario critical {
      app.in = {level = "critical", message = "breaker C2 open"}
      expect archive.in
      expect pager.in
      expect 2 app.out
    }

    scenario warning {
      app.in = {level = "warning", message = "voltage dip"}
      expect archive.in == nothing
      expect pager.in == nothing
      expect app.out == nothing
    }
  }
}
