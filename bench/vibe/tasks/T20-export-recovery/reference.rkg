graph guarded : App {
  input in: struct { valid: bool, reading: text }
  output out: text
  output err: union { TimeoutExpired {} }

  connector uplink : Process {
    mode = job ; command = "cat"
    codec = lines
    effect = idempotent ; behavior = deterministic
    timeout = duration("1s")
  }

  operator gate {
    input in: struct { valid: bool, reading: text }
    output out: text
    on in where data.valid {
      out = data.reading
    }
  }

  in -> gate -> uplink -> out
  uplink.err -> nothing
  uplink.exit -> match {
    TimeoutExpired -> err
    _ -> nothing
  }
}
