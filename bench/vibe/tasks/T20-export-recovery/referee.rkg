lab guarded {
  simulation refereeing on app {
    scenario exports "a valid reading uplinks" {
      mock uplink { on in { out = envelope } }
      app.in = {valid = true, reading = "flow 12"}
      expect "uplinked" app.out count == 1 where data == "flow 12"
      expect nothing app.err
    }

    scenario rejected "an invalid reading never uplinks" {
      mock uplink { on in { out = envelope } }
      app.in = {valid = false, reading = "flow 13"}
      expect nothing uplink.in
      expect nothing app.out
    }

    scenario hung "a mute uplink times out at one second" {
      mock uplink { on in { out = nothing } }
      app.in = {valid = true, reading = "flow 14"}
      advance duration("1s")
      expect "the typed timeout" app.err count == 1 where data.kind == "TimeoutExpired"
      expect nothing app.out
    }
  }
}
