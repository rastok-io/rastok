lab guarded {
  simulation refereeing {
    scenario exports {
      mock uplink { on in { out = .; exit = Exited { exit_code = 0; signal = null } } }
      app.in = {valid = true, reading = "flow 12"}
      expect app.out where data == "flow 12"
      expect app.err == nothing
    }

    scenario rejected {
      mock uplink { on in { out = .; exit = Exited { exit_code = 0; signal = null } } }
      app.in = {valid = false, reading = "flow 13"}
      expect uplink.in == nothing
      expect app.out == nothing
    }

    scenario hung {
      mock uplink { on in { out = nothing } }
      app.in = {valid = true, reading = "flow 14"}
      advance duration("1s")
      expect app.err where data is TimeoutExpired
      expect app.out == nothing
    }
  }
}
