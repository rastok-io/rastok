lab pipeline {
  simulation refereeing {
    scenario passes {
      app.in = {value = 180}
      expect app.out where data.value == 180
    }

    scenario clamped {
      app.in = {value = 900}
      expect app.out where data.value == 200
    }

    scenario gated {
      app.in = {value = -5}
      expect app.out == nothing
    }
  }
}
