lab convert {
  simulation refereeing on app {
    scenario freezing "zero converts to thirty-two" {
      app.in = {celsius = 0}
      expect "converted" app.out count == 1 where data.fahrenheit == 32
    }

    scenario boiling "one hundred converts to two-twelve" {
      app.in = {celsius = 100}
      expect "converted" app.out count == 1 where data.fahrenheit == 212
    }
  }
}
