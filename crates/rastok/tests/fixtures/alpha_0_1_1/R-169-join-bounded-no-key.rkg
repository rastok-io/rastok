// R-169 — A join bounded by `within`, with no key, still shifts inside its window
// Regression for release 0.1.1-alpha. Reproduced on rastok 0.1.0-alpha.
//
// Commands, run from this directory:
//   rastok check R-169-join-bounded-no-key.rkg
//   rastok simulate R-169-join-bounded-no-key.rkg
//
// Today (rastok 0.1.0-alpha):
//   $ rastok check R-169-join-bounded-no-key.rkg
//   ok: 6 node(s), semantic hash 747ed38b0af5c96c8ed1ec8fdac139b81d59c921ff02e25fdcd835d4989ec27d
//   [exit 0]
//   $ rastok simulate R-169-join-bounded-no-key.rkg
//   FAIL r169.second_call_inside_the_window
//        expect app.seen == { name = "item b"; status = 200 }  (R-169-join-bounded-no-key.rkg:100)
//        observed app.seen: {"name":"error page","status":200}
//        expected 1 matching delivery on app.seen, but observed 0
//   PASS r169.second_call_after_the_window
//   2 scenario(s), 1 failed
//   [exit 1]
//
// Expected after the fix:
//   `rastok check` prints W-JOIN-UNPAIRED here too: the bound only helps once it has
//   run out. The output of `simulate` is unchanged: the first scenario fails, the
//   second passes.

type Ask = struct { id: text }
type Item = struct { name: text }
type Seen = struct { name: text, status: int }
type JoinExpiry = union { JoinExpired {} }
graph app : App {
  input ask: Ask
  output seen: Seen
  output failed: text
  output lost: text
  operator send {
    input in: Ask
    output out: variant
    on in {
      val body = { id = data.id }
      out = body as variant
    }
  }
  connector catalog : HttpClient {
    url = "https://catalog.example.test/item"
    method = "POST"
    codec = json
    json_profile = projected
    output out: Item
    timeout = duration("5s")
    behavior = deterministic
  }
  operator pair {
    input body: Item
    input exit: HttpClientExit
    output out: Seen
    output expired: JoinExpiry
    on (body, exit) within duration("30s") match {
      exit.data is Completed => out = { name = body.data.name; status = exit.data.status }
      _ => out = { name = body.data.name; status = 0 }
    }
  }
  operator gone {
    input in: JoinExpiry
    output out: text
    on in { out = "expired" }
  }
  operator other {
    input in: HttpClientExit
    output out: text
    on in { out = "not completed" }
  }
  ask -> send -> catalog
  catalog.out -> pair.body
  catalog.exit -> match {
    Completed -> pair.exit
    _ -> other
  }
  pair.out -> seen
  pair.expired -> gone
  gone.out -> lost
  other.out -> failed
}
lab r169 {
  mock catalog {
    on in where data is Ask && data.id == "a" {
      out = { name = "error page" }
      exit = ServerError { status = 500 }
    }
    on in {
      out = { name = "item b" }
      exit = Completed { status = 200 }
    }
  }
  scenario second_call_inside_the_window {
    app.ask = { id = "a" }
    expect app.failed == "not completed"
    expect app.seen == nothing
    advance duration("5s")
    app.ask = { id = "b" }
    expect app.seen == { name = "item b"; status = 200 }
  }
  scenario second_call_after_the_window {
    app.ask = { id = "a" }
    expect app.failed == "not completed"
    advance duration("31s")
    expect app.lost == "expired"
    app.ask = { id = "b" }
    expect app.seen == { name = "item b"; status = 200 }
  }
}
