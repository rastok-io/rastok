// R-139 — The Lab asks for the secret of a Connector replaced by a fake
// Regression for release 0.1.1-alpha. Reproduced on rastok 0.1.0-alpha.
//
// Commands, run from this directory:
//   rastok simulate R-139-secret-and-fake.rkg
//   rastok simulate R-139-secret-and-fake.rkg --deployment R-139-secret-and-fake.deployment.json
//   env R139_TOKEN=lab-only-not-a-credential R139_TOKEN_VERSION=fixture-v1 rastok simulate R-139-secret-and-fake.rkg --deployment R-139-secret-and-fake.deployment.json
//
// Today (rastok 0.1.0-alpha):
//   $ rastok simulate R-139-secret-and-fake.rkg
//   FAIL r139.a_fake_stands_for_the_connector
//        the Lab Driver composition refused: Driver `lab-call` for `std/http-client@1` refused preparation: secret `AGENT_TOKEN` required by `agent.auth_bearer` is missing
//   1 scenario(s), 1 failed
//   [exit 1]
//   $ rastok simulate R-139-secret-and-fake.rkg --deployment R-139-secret-and-fake.deployment.json
//   error: secret `AGENT_TOKEN` did not match its attested version
//   [exit 1]
//   $ env R139_TOKEN=lab-only-not-a-credential R139_TOKEN_VERSION=fixture-v1 rastok simulate R-139-secret-and-fake.rkg --deployment R-139-secret-and-fake.deployment.json
//   PASS r139.a_fake_stands_for_the_connector
//   1 scenario(s), 0 failed
//   [exit 0]
//
// Expected after the fix:
//   The behavior stays: the Lab seals the resolved request, so it needs a synthetic
//   profile. The two refusals say what to do: the first names `--deployment` and the
//   profile's `secrets` entry, the second names the environment variable that is
//   not set instead of a version mismatch. The third command keeps passing.

type Ask = struct { id: text }
type Answer = struct { text: text }
graph app : App {
  input ask: Ask
  output done: Answer
  output ended: int
  connector agent : HttpClient {
    url = "https://agent.example.test/run"
    method = "POST"
    codec = json
    json_profile = projected
    output out: Answer
    timeout = duration("60s")
    auth_bearer = secret("AGENT_TOKEN")
    behavior = deterministic
  }
  operator send {
    input in: Ask
    output out: variant
    on in {
      val body = { id = data.id }
      out = body as variant
    }
  }
  operator code {
    input in: HttpClientExit
    output out: int
    on in match {
      data is Completed => out = 200
      _ => out = 0
    }
  }
  ask -> send -> agent
  agent.out -> done
  agent.exit -> code -> ended
}
lab r139 {
  mock agent {
    on in {
      out = { text = "done" }
      exit = Completed { status = 200 }
    }
  }
  scenario a_fake_stands_for_the_connector {
    app.ask = { id = "A" }
    expect app.ended == 200
  }
}
