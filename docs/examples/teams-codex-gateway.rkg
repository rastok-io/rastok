// =============================================================================
// teams-codex-gateway.rkg
//
// Teams <-> Codex bridge — historical pre-v16 design sketch (2026-08-23).
// Preserved for the proposed integration, NOT as a current syntax card or
// executable fixture. Its inferred interfaces, implicit output dispositions
// and prospective connector settings do not satisfy v16. The current
// checked gateway is docs/examples/codex-websocket-gateway.rkg; the current
// Loop example is examples/keyed-retry.rkg. R9 does not claim this future
// Teams/service/guest integration has been implemented.
//
// Demonstrates :
//   - graph composability : `sessions` = a per-key sub-graph, declared in place
//   - inference-first ports : Connectors declare none (their type + codec
//     define them) ; nodes lean on conventional in/out/err ; extra ports are
//     declared by NAME only (types inferred ; annotate `: T` only to pin)
//   - Composite configuration attributes (env = { … }, jwt = { … }, auth = { … })
//   - handler guards, the `data` payload, meta.sys / meta.app / meta.ext,
//     Node-owned instances and lifetimes,
//     deterministic simulations
//
// Syntax reference : docs/spec/grammar.md, docs/examples/dsl-examples.md, WHITEPAPER.md
// =============================================================================


// -----------------------------------------------------------------------------
// Composable Codex session.
// Keyed by its own `instance.key` → one logical Graph instance per session.
// -----------------------------------------------------------------------------

graph sessions {
  instance = { key = meta.app.session_key }
  lifetime = { kind = idle; after = duration("2h") }
  // One Graph instance per canonical session key. Capacity and placement are
  // deployment policy rather than logical attributes.
  // Single in / out pass-through → uses the default `in` / `out` ports.
  // Per-session config, derived from the key, as graph-level `val` :
  val session_key = instance.key
  val codex_home = "/var/codex/" + instance.key
  val cwd        = "/workspace/" + instance.key

  connector codex : Process {
    command = "codex"
    args = ["app-server"]
    mode = service
    cwd = cwd                              // graph-level val, by name
    env = {
      "CODEX_HOME": codex_home
      "RUST_LOG": "info"
    }
    codec = jsonl
    protocol = "jsonrpc"
    effect = idempotent
    behavior = probabilistic
    // in / out / err / exit = stdin / decoded stdout / stderr bytes / invocation terminal

    init = {
      message = { method = "initialize" }
      timeout = duration("10s")
    }
    kill = process_group
    restart = { backoff = "1s..30s", max_attempts = 5 }
  }

  connector codex_logs : File {
    // Prospective append/log profile, not the executable one-file
    // read/atomic-replace contract of std/file@1.
    path = "/var/codex/" + session_key + "/codex.stderr.log"
    codec = text
  }

  in        -> codex.in { capacity = 1024, backpressure = block }
  codex.out -> out
  codex.err -> codex_logs.in
}


// -----------------------------------------------------------------------------
// Teams gateway.
// Owns the HTTP listener and outbound HTTP client → singleton top-level graph,
// and the DEPLOYMENT ENTRY POINT of the unit (`: App` — exactly one per unit).
// `app` is pre-bound to it; every observable output remains a declared port.
// User isolation is delegated to `sessions` instances keyed by session_key.
// -----------------------------------------------------------------------------

graph teams_inbound : App {
  connector teams_in : HttpServer {
    listen = ":8080/adapters/teams/webhook"
    codec = json
    protocol = "teams_activity"

    hmac = env("TEAMS_HMAC_SECRET")
    nonce_ttl = duration("5m")
    jwt = {
      jwks_url   = "https://login.botframework.com/v1/.well-known/keys"
      cache_ttl  = duration("24h")
      audience   = env("TEAMS_BOT_APP_ID")
      issuer     = "https://api.botframework.com"
      clock_skew = duration("30s")
    }
    // teams_in.out carries the decoded webhook
  }

  // The fixed allow-list is graph config. A Memory snapshot is readable, but
  // using an asynchronous store for immutable boot configuration adds no value.
  val user_map : map<text, text> = { "abc-123": "user@example.test" }

  operator auth {
    // outputs : `out` (authorized) and `rejected`

    on in where data.from.aadObjectId in user_map {
      meta.app.session_key     = data.from.aadObjectId
      meta.app.user_id         = user_map[data.from.aadObjectId]
      meta.app.tenant_id       = data.channelData.tenant.id
      meta.app.conversation_id = data.conversation.id
      out = .
    }
    on in {
      meta.app.skip_reason = "unknown_user"
      rejected = .
    }
  }

  operator to_codex {
    on in {
      out = jq! {
        if .data.type == "invoke" then
          .meta.app.kind = "jsonrpc.peer_response"
          | .meta.app.rpc_id = (.data.value.approval_id | tostring)
          | .data = {
              decision: .data.value.verb,
              approval_id: .data.value.approval_id
            }
        elif .data.type == "message" then
          .data = {
            method: "turn/start",
            params: { prompt: .data.text }
          }
        else
          empty
        end
      }
    }
  }

  operator route_codex_out {

    on in {
      peer_request = jq! { select(.meta.app.kind == "jsonrpc.peer_request") }
      delta = jq! { select(.meta.app.method == "item/agentMessage/delta") }
      flush = jq! { select(.meta.app.method == "turn/completed") }
      message = jq! {
        select(.meta.app.kind == "jsonrpc.notification" and .meta.app.method == "item/agentMessage")
      }
    }
  }

  operator typing_feedback {
    on in {
      out = jq! { .data = { type: "typing" } }
    }
  }

  operator aggregate_reply {
    instance = {
      key = data.?params.?turn.?id.orValue(
        data.?params.?turnId.orValue(meta.app.session_key))
    }
    lifetime = { kind = idle; after = duration("30s") }

    var buffer: text = ""


    on delta {
      buffer = jq! { $buffer + (.data.params.delta // "") }
    }

    on flush {
      out = jq! {
        .meta.app.kind = "jsonrpc.notification"
        | .meta.app.method = "item/agentMessage"
        | .data = {
            method: "item/agentMessage",
            params: { message: $buffer }
          }
      }
      stop
    }
  }

  operator to_teams {
    on in {
      out = jq! {
        .meta.app.delivery_id = .meta.sys.id
        | if .meta.app.kind == "jsonrpc.peer_request" then
          .data = {
            type: "message",
            attachments: [
              {
                contentType: "application/vnd.microsoft.card.adaptive",
                content: {
                  type: "AdaptiveCard",
                  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                  version: "1.5",
                  body: [
                    {
                      type: "TextBlock",
                      text: ("Codex wants to run: " + (.data.params.command // "?")),
                      wrap: true
                    }
                  ],
                  actions: [
                    {
                      type: "Action.Execute",
                      verb: "approve",
                      title: "Approve",
                      data: { approval_id: (.meta.app.rpc_id // .data.id) }
                    },
                    {
                      type: "Action.Execute",
                      verb: "reject",
                      title: "Reject",
                      data: { approval_id: (.meta.app.rpc_id // .data.id) }
                    }
                  ]
                }
              }
            ]
          }
        elif .meta.app.kind == "jsonrpc.notification" and .meta.app.method == "item/agentMessage" then
          .data = {
            type: "message",
            text: .data.params.message
          }
        else
          empty
        end
      }
    }
  }

  graph teams_delivery : Loop {
    input in: variant
    output out: variant
    Loop.fuel = 3
    Loop.delay = {
      kind = exponential
      first = duration("200ms")
      ceiling = duration("5s")
    }

    connector teams_out : HttpClient {
      base_url = env("TEAMS_SERVICE_URL")
      path = "/v3/conversations/" + meta.app.conversation_id + "/activities"
      method = "POST"
      codec = json
      protocol = "teams_activity"
      effect = irreversible
      behavior = deterministic
      idempotency_key = meta.app.delivery_id
      timeout = duration("10s")
      rate_limit = "10/s per meta.app.session_key"
      auth = {
        scheme = oauth2_client_credentials
        token_endpoint = "https://login.microsoftonline.com/botframework.com/oauth2/v2.0/token"
        client_id = env("TEAMS_BOT_APP_ID")
        client_secret = env("TEAMS_BOT_PASSWORD")
        scope = "https://api.botframework.com/.default"
        refresh_before = duration("10m")
      }
    }

    . -> teams_out
    on teams_out.out { out = data }
    on teams_out.exit where data is ConnectFailed {
      next = Loop.state.data
    }
  }

  operator delivery_dispatch {

    on in {
      delivered = jq! { select(.data.delivered) }
      failed = jq! { select(.data.delivered | not) }
    }
  }

  connector dlq : Memory {
    cap      = 10000
    overflow = reject              // a strict DLQ : overflow is loud (CapacityExceeded)
  }
  // Memory is readable through its `read`/`out` snapshot contract. A replay
  // is a separate run that injects selected entries as new roots; this graph
  // does not hide a static back-edge.

  teams_in.out -> auth.in
  auth.out        -> to_codex.in
  auth.rejected   -> nothing
  to_codex.out    -> sessions.in

  sessions.out               -> route_codex_out.in
  route_codex_out.peer_request -> to_teams.in
  route_codex_out.message      -> to_teams.in
  route_codex_out.delta        -> typing_feedback.in
  route_codex_out.delta        -> aggregate_reply.delta
  route_codex_out.flush        -> aggregate_reply.flush

  typing_feedback.out   -> teams_delivery.in
  aggregate_reply.out   -> to_teams.in
  to_teams.out          -> teams_delivery.in

  teams_delivery.out        -> delivery_dispatch.in
  teams_delivery.expired    -> dlq.in
  delivery_dispatch.delivered   -> nothing
  delivery_dispatch.failed      -> dlq.in
}


// =============================================================================
// Simulations
// =============================================================================

lab teams_inbound {
  simulation teams_gateway {

    // The world, shared by the scenarios : codex is scripted per scenario ;
    // The nested HTTP Driver must be covered wherever it is called.

    scenario plain_message {
      mock sessions.codex {
        on in where data.method == "turn/start" {
          out = {                     // meta is written → long form (the { … } sugar carries data only)
            meta.app.kind   = "jsonrpc.notification"
            meta.app.method = "item/agentMessage"
            data = { method = "item/agentMessage", params = { message = "Bonjour" } }
          }
        }
      }
      mock teams_delivery.teams_out {
        on in { out = { delivered = true } }   // a data record: fresh data, metadata kept
      }

      teams_in.out = {
        meta.ext.source = "teams"      // the world's half seeds meta.ext — meta.sys is read-only, even in sim
        data = {
          type = "message"
          from = { aadObjectId = "abc-123" }
          text = "Bonjour"
          serviceUrl = "https://smba.trafficmanager.net/emea/"
          conversation = { id = "conv-1" }
          channelData = { tenant = { id = "tenant-x" } }
        }
      }

      expect sessions.codex.in where (data.method == "turn/start" && data.params.prompt == "Bonjour")
      expect teams_delivery.teams_out.in where (
        data.type == "message" && data.text.contains("Bonjour"))
    }

    scenario approval_cycle {
      mock sessions.codex {
        on in where data.method == "turn/start" {
          out = {
            meta.app.kind   = "jsonrpc.peer_request"
            meta.app.method = "item/commandExecution/requestApproval"
            meta.app.rpc_id = "42"
            data = { method = "item/commandExecution/requestApproval", id = 42, params = { command = "ls" } }
          }
        }
        on in where data.decision == "approve" {
          out = {
            meta.app.kind   = "jsonrpc.notification"
            meta.app.method = "item/agentMessage"
            data = { method = "item/agentMessage", params = { message = "completed" } }
          }
        }
      }
      mock teams_delivery.teams_out {
        on in { out = { delivered = true } }
      }

      teams_in.out = {
        type = "message"
        from = { aadObjectId = "abc-123" }
        text = "list files"
        serviceUrl = "https://smba.trafficmanager.net/emea/"
        conversation = { id = "conv-1" }
        channelData = { tenant = { id = "tenant-x" } }
      }
      expect teams_delivery.teams_out.in where (
         data.attachments[0].contentType == "application/vnd.microsoft.card.adaptive")

      teams_in.out = {
        type = "invoke"
        from = { aadObjectId = "abc-123" }
        value = { verb = "approve", approval_id = "42" }
        serviceUrl = "https://smba.trafficmanager.net/emea/"
        conversation = { id = "conv-1" }
        channelData = { tenant = { id = "tenant-x" } }
      }
      expect sessions.codex.in where (
         meta.app.kind == "jsonrpc.peer_response" && meta.app.rpc_id == "42" && data.decision == "approve")
      expect teams_delivery.teams_out.in where data.text.matches("completed|done")
    }

    scenario dlq_on_delivery_failure {
      mock sessions.codex {
        on in where data.method == "turn/start" {
          out = {
            meta.app.kind   = "jsonrpc.notification"
            meta.app.method = "item/agentMessage"
            data = { method = "item/agentMessage", params = { message = "Bonjour" } }
          }
        }
      }
      mock teams_delivery.teams_out {
        on in { out = { delivered = false, status = 503 } }    // the partner fails
      }

      teams_in.out = {
        type = "message"
        from = { aadObjectId = "abc-123" }
        text = "Bonjour"
        serviceUrl = "https://smba.trafficmanager.net/emea/"
        conversation = { id = "conv-1" }
        channelData = { tenant = { id = "tenant-x" } }
      }

      expect teams_delivery.teams_out.in where data.type == "message"
      expect dlq.in     where data.delivered == false
    }

    scenario unknown_user {
      teams_in.out = {
        type = "message"
        from = { aadObjectId = "intruder-999" }
        text = "Bonjour"
        serviceUrl = "https://smba.trafficmanager.net/emea/"
        conversation = { id = "conv-1" }
        channelData = { tenant = { id = "tenant-x" } }
      }
      expect auth.rejected where meta.app.skip_reason == "unknown_user"
      expect sessions.codex.in == nothing                       // codex never sees the intruder
    }
  }
}
