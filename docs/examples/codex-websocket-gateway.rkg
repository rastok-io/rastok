// =============================================================================
// Executable M1.6 Codex WebSocket gateway.
//
// One accepted socket is one logical Session. Each complete JSON message runs
// one bounded `codex exec --json -` job; the reply retains the socket's
// SessionRef through causal lineage. A later Process(service) profile can keep
// one app-server child alive per keyed Graph instance without changing this
// WebSocket boundary.
// =============================================================================

graph codex_websocket_gateway : App {
  input peer: variant
  output reply: variant
  output session_exit: variant
  output process_exit: variant

  connector codex : Process {
    command = "codex"
    args = ["exec", "--json", "-"]
    mode = job
    codec = jsonl
    timeout = duration("120s")
    max_output = "8MiB"
    idempotent = true
    behavior = probabilistic
  }

  connector clients : WebSocketServer {
    listen = "127.0.0.1:8443"
    path = "/codex"
    codec = json
    handshake_timeout = duration("10s")
    max_message = "1MiB"
    subprotocols = ["rastok.codex.v1"]
    correlate = meta.ext.session_id
    versions = ["http/3", "http/2", "http/1.1"]
  }

  clients.out -> codex.in
  peer -> codex.in
  codex.out -> clients.in
  codex.out -> reply
  codex.err -> nothing
  clients.exit -> session_exit
  codex.exit -> process_exit
}

lab codex_websocket_gateway {
  simulation two_sessions on app {
    mock codex {
      on in {
        out = data
        exit = Exited { exit_code = 0; signal = null }
      }
    }

    scenario isolation "two logical sessions cannot cross replies" {
      app.peer = {
        meta.ext.session_id = "11111111111111111111111111111111"
        data = { prompt = "alice" }
      }
      expect "alice reply" app.reply count == 1 where (
        meta.ext.session_id == "11111111111111111111111111111111")

      app.peer = {
        meta.ext.session_id = "22222222222222222222222222222222"
        data = { prompt = "bob" }
      }
      expect "bob reply" app.reply count == 1 where (
        meta.ext.session_id == "22222222222222222222222222222222")
    }
  }
}
