// Candidate, not an executable gallery page. M1 refuses effect = irreversible.
// D-2026-09-14-4 approves removing the global effect gate for ordinary Calls.
// This pre-cutover draft still refuses; do not relabel it idempotent to pass.
// One non-streaming Responses API call per job. The proposed Lab is offline.
// Prices in the companion deployment are fictional, not OpenAI tariffs.
val model_name = "gpt-6-astra"

type Job = struct { session: text, job: text, prompt: text }
type JsonObject = map<text, variant>
type Usage = struct {
  session: text
  job: text
  input_tokens: int @measure(id = gen_ai.usage.input_tokens)
  output_tokens: int @measure(id = gen_ai.usage.output_tokens)
}
type UnknownUsage = struct { session: text, job: text, reason: text }
type HttpExit = union {
  Completed { status: int }
  DnsFailed {}
  ConnectFailed {}
  TlsFailed {}
  ProtocolFailed {}
  TimeoutExpired {}
  BodyTooLarge { limit: uint }
  DecodeFailed {}
  OutcomeUnknown {}
}

graph agent_http : App {
  input in: Job
  output response: variant
  output usage: Usage
  output unknown: UnknownUsage
  output failed: HttpExit
  instance = { key = data.session }

  operator request {
    input in: Job
    output out: variant
    on in {
      val body = { model = model_name; input = data.prompt; stream = false; store = false; max_output_tokens = 128 }
      out = {
        data = body as variant
        meta.app.session = data.session
        meta.app.job = data.job
      }
    }
  }
  connector model : HttpClient {
    url = env("MODEL_URL")
    auth_bearer = secret("showcase/model/token")
    method = "POST"
    codec = json
    timeout = duration("10s")
    max_body = "256 KiB"
    effect = irreversible
    behavior = probabilistic
  }
  operator measure {
    input in: variant
    output usage: Usage
    output unknown: UnknownUsage
    on in match {
      data is JsonObject => match {
        has(data.usage) && data.usage is JsonObject => {
          val counts = data.usage as JsonObject
          match {
            has(counts.input_tokens) && counts.input_tokens is int && counts.input_tokens >= 0 && has(counts.output_tokens) && counts.output_tokens is int && counts.output_tokens >= 0 => usage = {
                session = meta.app.session as text
                job = meta.app.job as text
                input_tokens = counts.input_tokens as int
                output_tokens = counts.output_tokens as int
              }
            _ => unknown = { session = meta.app.session as text; job = meta.app.job as text; reason = "usage counts missing or invalid" }
          }
        }
        _ => unknown = { session = meta.app.session as text; job = meta.app.job as text; reason = "usage absent or not an object" }
      }
      _ => unknown = { session = meta.app.session as text; job = meta.app.job as text; reason = "response is not an object" }
    }
  }
  operator terminal {
    input in: HttpExit
    output failed: HttpExit
    output unknown: UnknownUsage
    on in match {
      data is Completed => match {
        data.status >= 200 && data.status < 300 => nothing
        _ => failed = Completed { status = data.status }
      }
      _ => {
        failed = .
        unknown = { session = meta.app.session as text; job = meta.app.job as text; reason = "no complete response: transport or decode failure" }
      }
    }
  }

  in -> request -> model
  model.out -> { response; measure }
  measure.usage -> usage
  measure.unknown -> unknown
  model.exit -> terminal
  terminal.failed -> failed
  terminal.unknown -> unknown
}

lab agent_http {
  simulation responses on app {
    mock model {
      on in match {
        meta.app.job == "missing" => {
          out = json! {"id":"response_missing","status":"completed","output":[],"extra":true}
          exit = Completed { status = 200 }
        }
        meta.app.job == "null" => {
          out = json! {"id":"response_null","usage":null}
          exit = Completed { status = 200 }
        }
        meta.app.job == "partial" => {
          out = json! {"usage":{"input_tokens":12}}
          exit = Completed { status = 200 }
        }
        meta.app.job == "invalid" => {
          out = json! {"usage":{"input_tokens":-1,"output_tokens":"unknown"}}
          exit = Completed { status = 200 }
        }
        meta.app.job == "zero" => {
          out = json! {"usage":{"input_tokens":0,"output_tokens":0}}
          exit = Completed { status = 200 }
        }
        meta.app.job == "timeout" => {}
        meta.app.job == "http_error" => {
          out = json! {"error":{"message":"scripted service error"}}
          exit = Completed { status = 500 }
        }
        _ => {
          out = json! {
            "id":"response_fixture","object":"response","status":"completed",
            "output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Hello from the simulated model.","annotations":[]}]}],
            "usage":{"input_tokens":12,"output_tokens":4,"input_tokens_details":{"cached_tokens":0},"output_tokens_details":{"reasoning_tokens":0},"total_tokens":16}
          }
          exit = Completed { status = 200 }
        }
      }
    }
    scenario two_sessions "three jobs, two session instances, exact observed usage" {
      app.in = { session = "alice"; job = "a1"; prompt = "Hello" }
      expect app.usage count == 1 where data.session == "alice" && data.job == "a1" && data.input_tokens == 12 && data.output_tokens == 4
      app.in = { session = "bob"; job = "b1"; prompt = "Hello" }
      expect app.usage count == 1 where data.session == "bob" && data.job == "b1"
      app.in = { session = "alice"; job = "a2"; prompt = "Another independent job" }
      expect app.usage count == 1 where data.session == "alice" && data.job == "a2"
      expect nothing app.unknown
      expect nothing app.failed
    }
    scenario missing_usage "absence and null never become zero" {
      app.in = { session = "alice"; job = "missing"; prompt = "Hello" }
      expect app.unknown count == 1 where data.reason == "usage absent or not an object"
      expect nothing app.usage
      app.in = { session = "alice"; job = "null"; prompt = "Hello" }
      expect app.unknown count == 1
      expect nothing app.usage
    }
    scenario invalid_usage "incomplete or mistyped counts remain unknown" {
      app.in = { session = "bob"; job = "partial"; prompt = "Hello" }
      expect app.unknown count == 1 where data.reason == "usage counts missing or invalid"
      expect nothing app.usage
      app.in = { session = "bob"; job = "invalid"; prompt = "Hello" }
      expect app.unknown count == 1
      expect nothing app.usage
    }
    scenario observed_zero "reported zero is not missing usage" {
      app.in = { session = "alice"; job = "zero"; prompt = "Hello" }
      expect app.usage count == 1 where data.input_tokens == 0 && data.output_tokens == 0
      expect nothing app.unknown
    }
    scenario transport_failure "a timeout has no invented usage" {
      app.in = { session = "alice"; job = "timeout"; prompt = "Hello" }
      advance duration("10s")
      expect app.failed count == 1 where data is TimeoutExpired
      expect app.unknown count == 1
      expect nothing app.usage
    }
    scenario http_error "HTTP 500 is a response, not a timeout" {
      app.in = { session = "alice"; job = "http_error"; prompt = "Hello" }
      expect app.failed count == 1 where data is Completed && data.status == 500
      expect app.unknown count == 1
      expect nothing app.usage
    }
  }
}
