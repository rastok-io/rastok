@startuml 03-rastok-components
!include <C4/C4_Component>

LAYOUT_LEFT_RIGHT()
title Rastok M0 — logical components inside the executable

System_Ext(project, "Project files", ".rkg source, scenarios, and golden artifacts.")
System_Ext(process, "Host process", "Real App-side Process effect.")

Container_Boundary(rastok_exec, "rastok executable") {
  Component(entry, "Command entry points", "Rust", "Coordinates check, App run, and Lab run.")
  Component(frontend, "Source front end", "Rust", "Parses .rkg and preserves source spans.")
  Component(checker, "Semantic checker", "Rust", "Validates names, types, ports, graph rules, and admitted aspects.")
  Component(planner, "Planner and canonicalizer", "Rust", "Builds an immutable plan with stable identity and ordering.")
  Component(core, "Runtime core", "Rust", "Applies deterministic state transitions and emits effect intents.")
  Component(dispatch, "Effect boundary", "Rust", "Routes an intent to the selected typed handler.")
  Component(app, "Process App handler", "Rust", "Resolves a Process intent against the host.")
  Component(lab, "Lab runner and handlers", "Rust", "Feeds controlled inputs, outcomes, virtual observations, and faults.")
  ComponentDb(journal, "In-memory journal", "Typed records", "Orders inputs and effect outcomes without choosing a durable layout.")
  Component(diff, "Diagnostics and golden diff", "Rust", "Renders source failures and meaningful Lab mismatches.")
}

Rel(entry, project, "Reads")
Rel(entry, frontend, "Parse")
Rel(frontend, checker, "Syntax plus spans")
Rel(checker, planner, "Checked graph")
Rel(entry, core, "Execute plan")
Rel(planner, core, "Immutable plan")
Rel(core, dispatch, "Effect intents")
Rel(dispatch, app, "App mode")
Rel(dispatch, lab, "Lab mode")
Rel(app, process, "Start and observe")
Rel(app, core, "Typed outcome event")
Rel(lab, core, "Controlled outcome event")
Rel(core, journal, "Append typed records")
Rel(entry, diff, "Render result")
Rel(diff, project, "Compare golden artifacts")
Rel(diff, frontend, "Uses source spans")

SHOW_LEGEND()
@enduml
