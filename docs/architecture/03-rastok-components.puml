@startuml 03-rastok-components
skinparam backgroundColor white
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Rastok — current responsibilities (package v17)

System_Ext(project, "Project files", "RKG, Lab scenarios, deployment profiles and golden artifacts.")
System_Ext(world, "External systems", "Process, File, HTTP and WebSocket peers.")
System_Ext(browser, "Optional browser", "simulate --ui; retained-transition inspection.")

Container_Boundary(executable, "rastok executable") {
  Component(entry, "CLI / Lab runner", "rastok", "Check, run, simulate and explicit logical-time inputs. One engine.")
  Component(compiler, "Compiler / Contract catalogue", "rastok", "Parse, resolve, type, Dispatch and route checks; canonical HIR identity.")
  Component(plan, "Validated plan gate", "rastok-core, no_std + alloc", "Independent v17 validation: scopes, Contracts, Dispatch, routes, policy and Loop proofs.")
  Component(core, "VM / HandlerExecutor / managers", "rastok-core", "Reserve before commit; atomic state, emissions and commands; recover from retained facts.")
  Component(binding, "Registry / runtime binding", "rastok", "Exact Contract id and role; pure request preparation shared by real and Lab Drivers.")
  Component(drivers, "Real or scripted Drivers", "rastok", "Physical effects after open; typed outcomes only. Network async stays private.")
  ComponentDb(journal, "Journal", "rastok-core: MemJournal", "INBOUND, TRANSACTION, OUTBOUND; routes, commands and retained original deadlines. No disk backend.")
  Component(report, "Policy / observations / CostReport", "rastok-core", "Validated annotations; redaction policy; exact journal-derived accounting.")
  Component(ui, "UI / structured logs", "rastok", "Never-block presentation, prefix-relative inspection; no second accounting ledger.")
  Component(evidence, "Diagnostics / golden diff", "rastok", "Named source failures, canonical trace projection and mismatch evidence.")
}

Rel(entry, project, "Reads source/profile; compares goldens")
Rel(entry, compiler, "Compile")
Rel(compiler, plan, "Candidate plan")
Rel(entry, core, "Drives validated plan")
Rel(plan, core, "Validated immutable tables")
Rel(entry, binding, "Bind before execution")
Rel(core, binding, "Prepared, journaled obligations")
Rel(binding, drivers, "Selected exact Contract")
Rel(drivers, world, "Real mode only")
Rel(drivers, core, "Typed external outcomes; never records")
Rel(core, journal, "Runtime mechanics alone commit")
Rel(journal, report, "Retained prefix")
Rel(report, ui, "Exact report and redacted values")
Rel(ui, browser, "Capability-protected snapshots / SSE")
Rel(core, ui, "Read-only VM inspection")
Rel(entry, evidence, "Render diagnostics / compare")
Rel(journal, evidence, "Canonical causal projection")

SHOW_LEGEND()
@enduml
