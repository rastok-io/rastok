@startuml 06-rastok-modules-overview
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
top to bottom direction
title Rastok — current Rust modules and crate boundary (v17, 2026-09-09)

package "rastok — hosted / compiler crate" as HOSTED {
  rectangle "main / render / diagnostics\nCLI assembly, source spans, named errors" as ENTRY
  rectangle "compiler\nsyntax / HIR / check / lower\nDispatch, routing, Extension checks" as COMP
  rectangle "contract / stdlib\nContractCatalog / ConnectorContract\nsix executable @2 sheets; frontend readers" as CATALOG
  rectangle "schema_projection / openapi\nstrict JSON Schema, Avro, Arrow, OpenAPI\ngenerated-source ownership" as SCHEMA
  rectangle "connectors\nDriverRegistry / RuntimeBindings\nProcess, File, HTTP, WebSocket\nprivate network: bounded async pump" as DRIVERS
  rectangle "deployment_config\nprofile JSON; explicit environment/provider input\nno clear credentials in semantic artifacts" as CONFIG
  rectangle "lab / conformance\nScenarioRun; controlled Drivers\nsame VM and exact Contracts" as LAB
  rectangle "ui / observability\nsimulate-only debugger; structured logs\nread-only prefix and never-block export" as UI
  rectangle "golden\nTrace / Divergence\ncausal projection, not full-record persistence" as GOLDEN
}

package "rastok-core — no_std + alloc" as CORE {
  rectangle "node / connector\nPath, Port, Kind, Extension, Trigger\nContractId, roles, exchange profiles" as NODE
  rectangle "datatype / value / envelope\nDataType, Value, Envelope, Data\none logical type/value authority" as DATA
  rectangle "expr / json / trivia\nTree, Signature, EvalValue\nbounded pure evaluation and exact readers" as EXPR
  rectangle "identity / canonical_cbor\nInstanceAddress, InstanceRef\ntagged values and canonical byte discipline" as IDENTITY
  rectangle "plan / loop_proof\nValidatedExecutionPlan, Owner, Dispatch\nRouteRule, ExtensionSpec, LoopSpec/LoopExpiry\nindependent scope, type and proof validation" as PLAN
  rectangle "runtime\nHandlerExecutor, Vm, Mailboxes, Scheduler\ncommand manager; spatial/exchange recovery\nGraph has no application handler" as VM
  rectangle "boundary\nInbound/Outbound Driver traits\nIntent, Completion, CallRef, SessionRef\nDispatcher and Contract completion gates" as BOUNDARY
  rectangle "journal / journal::loop_protocol\nJournal, MemJournal, Record\nLoopRunRef, command production/consumption\nretained original deadlines; no disk backend" as JOURNAL
  rectangle "schema_annotation / data_policy\ncanonical SchemaPath and five policies\nindependent propagation and redaction" as POLICY
  rectangle "deployment\nBootReference, BootBindings, SecretRef\nrun-scoped privacy/price attestations" as DEPLOY
  rectangle "observation / accounting\nRecordObservation / CostReport\nexact decimals, currency and unpriced facts" as REPORT
}

ENTRY -[hidden]right-> COMP
COMP -[hidden]right-> CATALOG
ENTRY -[hidden]down-> CONFIG
CONFIG -[hidden]right-> DRIVERS
DRIVERS -[hidden]right-> LAB
CONFIG -[hidden]down-> SCHEMA
SCHEMA -[hidden]right-> UI
UI -[hidden]right-> GOLDEN
GOLDEN -[hidden]down-> NODE
NODE -[hidden]right-> DATA
DATA -[hidden]right-> EXPR
NODE -[hidden]down-> IDENTITY
IDENTITY -[hidden]right-> PLAN
PLAN -[hidden]right-> VM
IDENTITY -[hidden]down-> BOUNDARY
BOUNDARY -[hidden]right-> JOURNAL
JOURNAL -[hidden]right-> POLICY
BOUNDARY -[hidden]down-> DEPLOY
DEPLOY -[hidden]right-> REPORT

HOSTED -down-> CORE : compile-time dependency only in this direction

legend bottom
Module inventory and crate dependency; execution relationships are in view 03.
Core never imports compiler, Lab, browser, network libraries or OS APIs.
The shared Node/Executor model is semantic; no public Executor trait.
endlegend
@enduml
