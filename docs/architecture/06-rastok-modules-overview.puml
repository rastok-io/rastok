@startuml 06-rastok-modules-overview
skinparam shadowing false
skinparam packageStyle rectangle

title Rastok — bird's-eye module overview (M1.4 R3 routing, 2026-08-21)

note as LEGEND
  Representative load-bearing modules and types (public or
  architecturally named) ; no fields, no methods, no type-level arrows.
  Arrows are module-level **uses** only ; trait implementations,
  ownership edges, and build artifacts are deliberately not shown.
  Incidental arrows into the shared `node`, `envelope`, and
  `diagnostics` foundations are omitted.
  «next» = named later slice ;
  «guarded» = reachable syntax refuses explicitly.
end note

package "node — shared graph and execution vocabulary" as P_NODE {
  class Path <<struct>>
  Path : stable root-relative node address
  enum Kind <<enum>>
  Kind : operator, connector, or graph category
  class Port <<struct>>
  Port : named node endpoint
  enum Direction <<enum>>
  Direction : input or output port role
  enum EffectClass <<enum>>
  EffectClass : external-effect risk category
  enum Effect <<enum>>
  Effect : absence or declared class of effect
  enum Behavior <<enum>>
  Behavior : deterministic or probabilistic execution
  enum Lifecycle <<enum>>
  Lifecycle : non-port transaction causes (timeout, …)
  enum Trigger <<enum>>
  Trigger : the CAUSE a committed transaction records
  enum HandlerActivation <<enum>>
  HandlerActivation : the PATTERN a handler declares (≠ Trigger)
}

package "envelope — data and metadata carried through the graph" as P_ENV {
  class Envelope <<struct>>
  Envelope : immutable emitted message
  class Meta <<struct>>
  Meta : exactly sys, app, and ext metadata zones
  class MetaSys <<struct>>
  MetaSys : runtime-owned five-field identity spine
  class Id <<struct>>
  Id : deterministically derived 128-bit identity
  enum Data <<enum>>
  Data : encoded or materialized envelope data
  enum Encoding <<enum>>
  Encoding : raw, Avro, or Arrow IPC encoding
  enum Scalar <<enum>>
  Scalar : restricted metadata leaf
  enum Role <<enum>>
  Role : default or compensate flow
  enum WriteTarget <<enum>>
  WriteTarget : checked landing site of a builder write
}

package "diagnostics — structured diagnostics shared across phases" as P_DIAG {
  class "Diagnostic" as DIAG_Diagnostic <<struct>>
  DIAG_Diagnostic : stable diagnostic identity and structured details
  class Code <<struct>>
  Code : registry code carrying severity by prefix
  enum Severity <<enum>>
  Severity : error or warning
  enum Phase <<enum>>
  Phase : parse, resolve, check, plan, run, replay, or simulation
  class Span <<struct>>
  Span : source id and byte range
  class Bag <<struct>>
  Bag : accumulating diagnostic destination
}

package "datatype / value — core logical data authority" as P_DATA {
  enum DataType <<enum>>
  DataType : logical type tree and recursive conformance judge
  enum "Value" as CORE_Value <<enum>>
  CORE_Value : one materialized domain and structural validator
}

package "expr — Rastok expression engine" as P_EXPR {
  class Signature <<struct>>
  Signature : names and types visible to an expression
  class Tree <<struct>>
  Tree : canonical typed expression tree
  enum EvalValue <<enum>>
  EvalValue : transient core value or lazy payload witness
  class "Diagnostic" as Expr_Diagnostic <<struct>>
  Expr_Diagnostic : native expression compiler diagnostic
  class "Error" as Expr_Error <<struct>>
  Expr_Error : expression evaluation error
}

note bottom of P_EXPR
  owns neither DataType nor materialized Value;
  compatible operations retain the CEL oracle
end note

package "canonical_cbor — bounded canonical byte discipline" as P_CBOR {
  enum "Value" as CBOR_Value <<enum>>
  CBOR_Value : canonical CBOR value tree
  class CanonicalDouble <<struct>>
  CanonicalDouble : one bit form for each canonical double
  enum "DecodeError" as CBOR_Error <<enum>>
  CBOR_Error : typed malformed, non-canonical, or over-budget input
}

package "identity — canonical identities and tagged values" as P_IDENT {
  class InstanceAddress <<struct>>
  InstanceAddress : owner path plus outer-to-inner canonical frames
  class InstanceRef <<struct>>
  InstanceRef : logical address plus journal-derived generation
  class "value_tagged / meta_tagged" as IDENT_API <<mod>>
  IDENT_API : one extend-only value alphabet for plans and traces
}

package "json — exact JSON document reader and writer" as P_JSON {
  enum DeclaredNumber <<enum>>
  DeclaredNumber : int, uint, or exact decimal under hard budgets
  class JsonError <<struct>>
  JsonError : positioned typed read/write refusal
  class "parse_value / write_value" as JSON_API <<mod>>
  JSON_API : one house codec shared by literals and jsonl
}

package "schema_projection — strict external schema boundary" as P_SCHEMA {
  enum LossReason <<enum>>
  LossReason : stable refusal category
  class ProjectionError <<struct>>
  ProjectionError : path, reason, and detail
  class "json_schema / avro / arrow" as SCHEMA_API <<mod>>
  SCHEMA_API : exact logical projection and reverse capability check
}

package "trivia — one lexical comment fact" as P_TRIVIA {
  class Comment <<struct>>
  Comment : comment extent, termination, and multiline fact
  class comment_at <<mod>>
  comment_at : recognition only; each consumer owns policy
}

package "compiler — source-to-plan compilation pipeline" as P_COMP {
  class Compilation <<struct>>
  Compilation : valid plan, symbols, hash, warnings, and checked labs
  class SyntaxTree <<struct>>
  SyntaxTree : source-faithful parsed representation
  class Lexer <<struct>>
  Lexer : owns the only byte cursor and token lookahead
  enum StatementHead <<enum>>
  StatementHead : structural, bare value, or recovery
  enum ValueHead <<enum>>
  ValueHead : structural or expression region
  class Unit <<struct>>
  Unit : merged application and lab sources
  class Hir <<struct>>
  Hir : desugared, resolved, and typed graph + labs
  enum NodeRole <<enum>>
  NodeRole : graph, operator, or connector with its resolved contract
  class Lab <<struct>>
  Lab : checked simulation corpus (never hashed)
  class Scenario <<struct>>
  Scenario : checked steps, mocks, and expectations
  class "guest frontend seam" as GuestFrontend <<guarded>>
  GuestFrontend : no placeholder type until one implementation lands
}

package "plan — serializable compiled execution model" as P_PLAN {
  class ExecutionPlan <<struct>>
  ExecutionPlan : parent-linked owner tree plus scoped edges and handlers
  class ValidatedExecutionPlan <<struct>>
  ValidatedExecutionPlan : plan plus total effective port types
  class ResolvedPortTable <<struct>>
  ResolvedPortTable : exact declared/inferred type of every port
  enum NodeKind <<enum>>
  NodeKind : executable operator or connector with its spec
  class Owner <<struct>>
  Owner : parent-linked lexical Graph or Node scope
  enum OwnerKind <<enum>>
  OwnerKind : graph or reciprocal executable Node slot
  class OwnerSlot <<struct>>
  OwnerSlot : compile-time resolved owner reference
  class OwnerValue <<struct>>
  OwnerValue : typed immutable expression, phase, and plan reduction
  enum EvaluationSite <<enum>>
  EvaluationSite : plan, boot, instance, or invocation
  class ConnectorSpec <<struct>>
  ConnectorSpec : typed effect, behavior, and effective phase-tagged attributes
  class Handler <<struct>>
  Handler : activation-selected ordered statement body
  class InstanceSpec <<struct>>
  InstanceSpec : optional key expression and independent lifetime profile
  class Slot <<struct>>
  Slot : compile-time resolved reference
  class SymbolTable <<struct>>
  SymbolTable : diagnostic and trace symbol information
  class SemanticHash <<struct>>
  SemanticHash : canonical HIR identity
  class GraphVersion <<struct>>
  GraphVersion : append-only deployed graph version
  class Manifest <<struct>>
  Manifest : semantic-hash to graph-version ledger
  class GuestProgram <<struct>> <<next>>
  GuestProgram : opaque compiled guest program
  class AssetBlob <<struct>>
  AssetBlob : content-addressed build-time asset bytes
  class "encode / decode (categorical v9)" as PLAN_CODEC <<mod>>
  PLAN_CODEC : canonical validated plan package transport
}

package "contract — compiler-layer node contract metamodel" as P_CONTRACT {
  class ConnectorContract <<struct>>
  ConnectorContract : ports, attributes, and profiles
  class AttributeSpec <<struct>>
  AttributeSpec : name, presence, and value domain
  enum Presence <<enum>>
  Presence : required, optional, or defaulted
  enum DefaultValue <<enum>>
  DefaultValue : choice word or constant Rastok expression
  enum ValueDomain <<enum>>
  ValueDomain : choice, scalar constant, or deferred composite domain
  enum Availability <<enum>>
  Availability : available sheet, declared name, or unknown capability
  class ProfileSelector <<struct>>
  ProfileSelector : selects an available or deferred profile
  class Registry <<struct>>
  Registry : validated sheets and declared capability names
}

package "stdlib — standard catalogue instances" as P_STD {
  class PROCESS <<const>>
  PROCESS : the available Process contract sheet
  class GuestContract <<struct>>
  GuestContract : declared language name and current availability
}

package "boundary — contracts with the external world" as P_BND {
  interface InboundConnectorDriver <<trait>>
  InboundConnectorDriver : supplies inbound submissions under backpressure
  interface OutboundConnectorDriver <<trait>>
  OutboundConnectorDriver : starts calls, answers or stays silent, cancels on demand
  interface CompletionGate <<trait>>
  CompletionGate : admits every typed port draft before call closure
  interface Clock <<trait>>
  Clock : supplies one due event at a time (current driver uses target advance)
  interface Supervisor <<trait>>
  Supervisor : supplies lifecycle events (current build: boot only)
  class Dispatcher <<struct>>
  Dispatcher : starts journaled calls, settles gated closures
  class PumpBatch <<struct>>
  PumpBatch : events, discarded, uncorrelated, rejected — nothing silent
  class BoundaryEvent <<struct>>
  BoundaryEvent : one routable won closure
  class CallRef <<struct>>
  CallRef : deterministic internal call identity
  class InboundSubmission <<struct>>
  InboundSubmission : draft proposed for atomic acceptance
  class IngressAuthority <<struct>>
  IngressAuthority : opaque connector-path and replica authority
  class Intent <<struct>>
  Intent : canonical journaled outbound-call intent
  class PreparedRequest <<struct>>
  PreparedRequest : exact request bytes sealed with their digest
  enum RequestCodec <<enum>>
  RequestCodec : Process lines, jsonl, or bytes framing
  class "prepare_request / process_exit_type" as BND_PREP <<mod>>
  BND_PREP : pure framing and Process port-type authority
  class PortOutput <<struct>>
  PortOutput : one ordinary typed output draft
  class Completion <<struct>>
  Completion : ordered drafts ending in exactly one exit
  enum ProcessExit <<enum>>
  ProcessExit : exact terminal union for one Process invocation
  class Response <<struct>>
  Response : protocol-correlated atomic completion
  enum DatedPayload <<enum>>
  DatedPayload : delivery budget or Node-instance lifetime event
}

package "runtime — deterministic execution machinery" as P_RT {
  class Vm <<struct>>
  Vm : pure engine — boot, inject, step, drain, pump, advance
  class Scheduler <<struct>>
  Scheduler : deterministic work picking; the dated-event queue
  class Mailboxes <<struct>>
  Mailboxes : bounded FIFO queues per instance reference
  class Delivery <<struct>>
  Delivery : one queued envelope with its port, edge, and seq
  class TransactionExecutor <<struct>>
  TransactionExecutor : atomic node-transaction executor
  class InstanceState <<struct>>
  InstanceState : private Node state cells indexed by instance reference
  class EmissionBuffer <<struct>>
  EmissionBuffer : ordered per-port emissions
  class Observed <<struct>>
  Observed : one logged delivery — the observation surface
  enum Fault <<enum>>
  Fault : engine refusal returned to supervision, transaction uncommitted
  interface GuestExecutor <<trait>>
  GuestExecutor : pure deterministic guest execution contract
  class BootBindings <<struct>> <<next>>
  BootBindings : deployment bindings resolved at boot
  class "Secret<T>" as SecretT <<struct>> <<next>>
  SecretT : non-serializable protected binding
}

package "journal — durable causal history and recovery model" as P_J {
  interface Journal <<trait>>
  Journal : semantic journal operations
  class CommittedInbound <<struct>>
  CommittedInbound : accepted inbound envelope and record
  enum CloseVerdict <<enum>>
  CloseVerdict : won or already-closed result
  enum Closure <<enum>>
  Closure : driver completion or machine timeout
  class MemJournal <<struct>>
  MemJournal : current in-memory journal implementation
  enum Record <<enum>>
  Record : inbound, transaction, or outbound record
  class TransactionRecord <<struct>>
  TransactionRecord : instance ref, parent ref, consumed, delta, emissions, routes, cause
  class OutboundRecord <<struct>>
  OutboundRecord : journaled external-call record
  class "mod ids" as IDS_API <<mod>>
  IDS_API : identity recipes — root, emission, call, budget
  class RecoveryFold <<struct>> <<next>>
  RecoveryFold : journal-to-state recovery fold
}

package "golden — canonical projection, seal, and diff" as P_GOLD {
  class Trace <<struct>>
  Trace : canonical record bytes with their structured trees
  class Divergence <<struct>>
  Divergence : first difference, by record and named key path
  class "mod golden" as GOLD_API <<mod>>
  GOLD_API : project, seal, diff over shared canonical CBOR
}

package "connectors — concrete external-effect Drivers" as P_CONN {
  class Process <<struct>>
  Process : pre-bound async process Driver; out*, err*, then typed exit
  class ProcessBindError <<struct>>
  ProcessBindError : refuses an unserved or unresolved plan before VM boot
  class "HttpServer, HttpClient, Clock,\nCalendar, Memory, File" as CATALOGUE <<guarded>>
  CATALOGUE : declared names — sheets and Drivers land by slice
}

package "conformance — Driver contract harness" as P_CONF {
  interface OutboundConnectorDriverFactory <<trait>>
  OutboundConnectorDriverFactory : builds the Driver behind the production OutboundConnectorDriver seam
  class Profile <<struct>>
  Profile : provocations and declared proof surface
  class Report <<struct>>
  Report : passed, failed, and honestly unproven cases
}

package "lab — the scenario runner" as P_LAB {
  class ScenarioRun <<struct>>
  ScenarioRun : one executed scenario — verdict and journal records
  class ScenarioReport <<struct>>
  ScenarioReport : named failures; empty means green
  class "mod lab" as LAB_API <<mod>>
  LAB_API : run — drives scenarios on the production Vm
}

note bottom of P_LAB
  the scenario forms live in compiler::hir (one
  parser, one checker) ; the fixture IS the scenario's
  steps ; virtual time IS Vm::advance — no separate
  Fixture or VirtualClock types exist
end note

package "render — rustc-shaped diagnostic rendering" as P_REN {
  class Sources <<struct>>
  Sources : the compiled sources spans resolve against
  class "mod render" as REN_API <<mod>>
  REN_API : code, file:line:col, source line, underline
}

package "cli — binary assembly (main.rs)" as P_CLI {
  class "check | run | simulate" as VERBS <<bin>>
  VERBS : wiring and verbs; owns nothing semantic
}

